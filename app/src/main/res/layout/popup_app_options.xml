<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_popup_menu"
    android:clipToOutline="true"
    android:elevation="8dp"
    android:orientation="vertical"
    android:padding="4dp">

    <TextView
        android:id="@+id/optionMove"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/selector_popup_item"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:minWidth="75dp"
        android:nextFocusDown="@id/optionUninstall"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp"
        android:text="Move App"
        android:textColor="@color/white"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/optionUninstall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/selector_popup_item"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:minWidth="75dp"
        android:nextFocusUp="@id/optionMove"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp"
        android:text="Uninstall"
        android:textColor="@color/accent"
        android:textSize="12sp" />

</LinearLayout>
