<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg"
    android:keepScreenOn="true"
    tools:ignore="NestedWeights">

    <!-- Shared TMDB backdrop (same as main page). Blurred on API 31+ and dimmed
         below so that the settings text — especially greyed-out values — remains
         legible regardless of which backdrop is active. -->
    <ImageView
        android:id="@+id/wallpaperBG"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/wallpaperDim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000" />

    <View
        android:id="@+id/mainBG"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_home_bg" />

    <!-- ══ Left side panel ══ -->
    <LinearLayout
        android:id="@+id/ll_side"
        android:layout_width="220dp"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Static title (not focusable) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="100dp"
            android:text="Settings"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginBottom="20dp"
            android:text="Select section"
            android:textColor="@android:color/white"
            android:textSize="10sp" />

        <!-- "General" section selector -->
        <LinearLayout
            android:id="@+id/sectionMain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/selector_setting"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusRight="@id/wallSource"
            android:nextFocusDown="@id/sectionSystem"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="General"
                android:textColor="@color/white"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- "System" section selector -->
        <LinearLayout
            android:id="@+id/sectionSystem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/selector_setting"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusRight="@id/showHideApps"
            android:nextFocusUp="@id/sectionMain"
            android:nextFocusDown="@id/sectionAbout"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="System"
                android:textColor="@color/white"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- "About" section selector -->
        <LinearLayout
            android:id="@+id/sectionAbout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/selector_setting"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusUp="@id/sectionSystem"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="About"
                android:textColor="@color/white"
                android:textSize="16sp" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/appVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:text="Version"
            android:textColor="@color/white"
            android:textSize="10sp" />

    </LinearLayout>

    <!-- ══ Right panel container ══ -->
    <FrameLayout
        android:id="@+id/rightContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toRightOf="@id/ll_side">

        <!-- ── General / main settings panel (default visible) ── -->
        <ScrollView
            android:id="@+id/panelMain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:scrollbars="none"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="100dp"
                android:layout_marginEnd="50dp"
                android:orientation="vertical">

                <!-- ══════════════════════════════════════════════════════════
                     Wallpapers Settings sub-section.
                     Rows underneath are conditionally visible based on the
                     selected source (TMDB vs Local) — visibility is toggled
                     at runtime in SettingsActivity.
                     ══════════════════════════════════════════════════════════ -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="12dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="WALLPAPERS SETTINGS"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:ignore="RtlSymmetry" />

                <!-- Source (TMDB / Local) — click to toggle -->
                <LinearLayout
                    android:id="@+id/wallSource"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/selector_setting"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nextFocusLeft="@id/sectionMain"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:text="Source"
                        android:textColor="@color/white"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/wallSourceText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        tools:text="TMDB" />
                </LinearLayout>

                <!-- ▾ TMDB-only rows: TMDB API Key, Wallpaper Type ▾ -->

                <LinearLayout
                    android:id="@+id/tmdbKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/selector_setting"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nextFocusLeft="@id/sectionMain"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:text="TMDB API Key"
                        android:textColor="@color/white"
                        android:textSize="18sp" />

                    <EditText
                        android:id="@+id/tmdbKeyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:hint="Enter TMDB API Key"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:singleLine="true"
                        android:textColor="@color/white"
                        android:textColorHint="@color/white_50"
                        android:textSize="18sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/wall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/selector_setting"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nextFocusLeft="@id/sectionMain"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:text="Wallpaper Type"
                        android:textColor="@color/white"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/wallText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        tools:text="Trending" />
                </LinearLayout>

                <!-- ▾ Local-only row: folder picker ▾ -->

                <LinearLayout
                    android:id="@+id/wallLocalFolder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/selector_setting"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nextFocusLeft="@id/sectionMain"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:text="Local Folder"
                        android:textColor="@color/white"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/wallLocalFolderText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="middle"
                        android:gravity="end"
                        android:singleLine="true"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        tools:text="/sdcard/Pictures/Backgrounds" />
                </LinearLayout>

                <!-- ▾ Shared rows: Auto Cycle + Cycle Interval (both sources) ▾ -->

                <LinearLayout
                    android:id="@+id/wallAuto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/selector_setting"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nextFocusLeft="@id/sectionMain"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:text="Auto Cycle"
                        android:textColor="@color/white"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/wallAutoText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        tools:text="On" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/wallCycleInterval"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/selector_setting"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nextFocusLeft="@id/sectionMain"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:text="Cycle Interval"
                        android:textColor="@color/white"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/wallCycleIntervalText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        tools:text="30 sec" />
                </LinearLayout>

                <!-- Note: "Default TV Launcher", "Auto Start on Boot", "TV App
                     Row Height", and "Mobile App Row Height" live in the Quick
                     Settings overlay (QuickSettingsOverlay), not here. -->

            </LinearLayout>
        </ScrollView>

        <!-- ── System panel (initially hidden) ── -->
        <ScrollView
            android:id="@+id/panelSystem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="100dp"
                android:layout_marginEnd="50dp"
                android:orientation="vertical">

                <!-- Show / Hide Apps -->
                <LinearLayout
                    android:id="@+id/showHideApps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/selector_setting"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nextFocusLeft="@id/sectionSystem"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:text="Show / Hide Apps"
                        android:textColor="@color/white"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="Manage"
                        android:textColor="@color/white_50"
                        android:textSize="18sp" />
                </LinearLayout>

                <!-- File Browser -->
                <LinearLayout
                    android:id="@+id/fileBrowser"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/selector_setting"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nextFocusLeft="@id/sectionSystem"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:text="File Browser"
                        android:textColor="@color/white"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="Browse"
                        android:textColor="@color/white_50"
                        android:textSize="18sp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- ── About panel (system / device information) ── -->
        <ScrollView
            android:id="@+id/panelAbout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="20dp"
            android:layout_marginTop="100dp"
            android:layout_marginEnd="50dp"
            android:layout_marginBottom="20dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="20dp">

                <!-- Each row: label on left, value on right. IDs end in "Val". -->
                <include
                    android:id="@+id/aboutAndroidVersion"
                    layout="@layout/item_about_row" />

                <include
                    android:id="@+id/aboutBuildNumber"
                    layout="@layout/item_about_row" />

                <include
                    android:id="@+id/aboutBuildDate"
                    layout="@layout/item_about_row" />

                <include
                    android:id="@+id/aboutSecurityPatch"
                    layout="@layout/item_about_row" />

                <include
                    android:id="@+id/aboutKernel"
                    layout="@layout/item_about_row" />

                <include
                    android:id="@+id/aboutBrand"
                    layout="@layout/item_about_row" />

                <include
                    android:id="@+id/aboutManufacturer"
                    layout="@layout/item_about_row" />

                <include
                    android:id="@+id/aboutModel"
                    layout="@layout/item_about_row" />

                <include
                    android:id="@+id/aboutDevice"
                    layout="@layout/item_about_row" />

                <include
                    android:id="@+id/aboutProduct"
                    layout="@layout/item_about_row" />

                <include
                    android:id="@+id/aboutBoard"
                    layout="@layout/item_about_row" />

                <include
                    android:id="@+id/aboutHardware"
                    layout="@layout/item_about_row" />

                <include
                    android:id="@+id/aboutProcessor"
                    layout="@layout/item_about_row" />

                <include
                    android:id="@+id/aboutCpuArch"
                    layout="@layout/item_about_row" />

                <include
                    android:id="@+id/aboutAbis"
                    layout="@layout/item_about_row" />

                <include
                    android:id="@+id/aboutResolution"
                    layout="@layout/item_about_row" />

                <include
                    android:id="@+id/aboutDensity"
                    layout="@layout/item_about_row" />

                <include
                    android:id="@+id/aboutRefresh"
                    layout="@layout/item_about_row" />

                <include
                    android:id="@+id/aboutRam"
                    layout="@layout/item_about_row" />

                <include
                    android:id="@+id/aboutStorage"
                    layout="@layout/item_about_row" />

                <include
                    android:id="@+id/aboutBootloader"
                    layout="@layout/item_about_row" />

                <include
                    android:id="@+id/aboutAppVersion"
                    layout="@layout/item_about_row" />

            </LinearLayout>
        </ScrollView>

    </FrameLayout>

</RelativeLayout>
