<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/shap_home_bg"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:id="@+id/topLayout"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/tvWifi"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/selector_home"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:padding="10dp"
                android:src="@drawable/ic_home_network_no"
                android:tag="hmTop" />

            <ImageView
                android:id="@+id/tvMenu"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/selector_home"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusRight="@id/tvMenu"
                android:padding="10dp"
                android:src="@drawable/ic_home_setting"
                android:tag="hmTop" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="15dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:fontFamily="@font/roboto_light"
                    android:gravity="center"
                    android:textAlignment="gravity"
                    android:textColor="@android:color/white"
                    android:textSize="36sp"
                    tools:text="22:00" />

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:fontFamily="@font/roboto_thin"
                    android:gravity="center|start|left"
                    android:lineSpacingMultiplier="0.9"
                    android:textAlignment="gravity"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    tools:text="20 April\nWednesday" />

            </LinearLayout>

        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="120dp"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:fontFamily="@font/roboto_thin"
                    android:text="TV Apps"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    tools:text="TV Apps" />

                <com.takagen.launcher.ui.custom.CustomHorizontalGridView
                    android:id="@+id/recycler_banner"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:padding="24dp"
                    app:focusOutEnd="true"
                    app:focusOutFront="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="8dp"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:fontFamily="@font/roboto_thin"
                    android:text="Mobile Apps"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    tools:text="Mobile Apps" />

                <com.takagen.launcher.ui.custom.CustomHorizontalGridView
                    android:id="@+id/recycler_icon"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:padding="24dp"
                    app:focusOutEnd="true"
                    app:focusOutFront="true" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

</FrameLayout>