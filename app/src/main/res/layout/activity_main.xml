<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/frameBG"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg">

    <View
        android:id="@+id/mainBG"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/shape_home_bg"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:id="@+id/topLayout"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvPosterTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/selector_home"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:fontFamily="@font/roboto_thin"
                android:nextFocusLeft="@id/tvPosterTitle"
                android:paddingStart="8dp"
                android:paddingTop="5dp"
                android:paddingEnd="8dp"
                android:paddingBottom="5dp"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                tools:text="poster title" />

            <ImageView
                android:id="@+id/tvRefresh"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/selector_home"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:padding="7dp"
                android:src="@drawable/ic_home_refresh"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/tvInput"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/selector_home"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:padding="12dp"
                android:src="@drawable/ic_home_input" />

            <ImageView
                android:id="@+id/tvClear"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/selector_home"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:padding="5dp"
                android:src="@drawable/ic_home_clear" />

            <ImageView
                android:id="@+id/tvWifi"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/selector_home"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:padding="10dp"
                android:src="@drawable/ic_home_network_no" />

            <ImageView
                android:id="@+id/tvMenu"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/selector_home"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusRight="@id/tvMenu"
                android:padding="10dp"
                android:src="@drawable/ic_home_setting" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/clockLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:fontFamily="@font/roboto_light"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="64sp"
                android:textStyle="bold"
                tools:text="22:00" />

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="16dp"
                android:focusable="false"
                android:fontFamily="@font/roboto_thin"
                android:gravity="center|start"
                android:lineSpacingMultiplier="0.9"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                tools:text="20 April\nWednesday" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mainRecycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:focusable="true"
            android:focusableInTouchMode="true" />

    </LinearLayout>

</FrameLayout>
