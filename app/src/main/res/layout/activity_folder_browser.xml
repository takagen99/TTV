<?xml version="1.0" encoding="utf-8"?>
<!--
    Built-in folder browser used when DocumentsUI / system SAF picker is not
    available (e.g. slim Android TV ROMs). Walks the filesystem via java.io.File
    and returns the user's pick as an absolute path via setResult.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg"
    android:keepScreenOn="true">

    <!-- Shared launcher backdrop, blurred on API 31+ (same treatment as Settings). -->
    <ImageView
        android:id="@+id/wallpaperBG"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/wallpaperDim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="60dp"
        android:paddingTop="80dp"
        android:paddingEnd="60dp"
        android:paddingBottom="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pick a Folder"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/currentPath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textColor="@color/white_50"
            android:textSize="13sp"
            tools:text="/storage/emulated/0/Pictures" />

        <!-- Folder list. Items are added dynamically by FolderBrowserActivity;
             using RecyclerView to match the rest of the project's style. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/folderList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:focusable="true"
            android:paddingBottom="12dp" />

        <!-- Empty-state message shown when the folder has no browsable children. -->
        <TextView
            android:id="@+id/emptyMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="No sub-folders here. Press Select to pick this folder, or Up to go back."
            android:textColor="@color/white_50"
            android:textSize="14sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Action bar: Up / Cancel / Select. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/selector_setting"
                android:focusable="true"
                android:minWidth="120dp"
                android:paddingStart="20dp"
                android:paddingTop="10dp"
                android:paddingEnd="20dp"
                android:paddingBottom="10dp"
                android:text="Up"
                android:textColor="@color/white" />

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:background="@drawable/selector_setting"
                android:focusable="true"
                android:minWidth="120dp"
                android:paddingStart="20dp"
                android:paddingTop="10dp"
                android:paddingEnd="20dp"
                android:paddingBottom="10dp"
                android:text="Cancel"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/btnSelect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/selector_setting"
                android:focusable="true"
                android:minWidth="180dp"
                android:paddingStart="20dp"
                android:paddingTop="10dp"
                android:paddingEnd="20dp"
                android:paddingBottom="10dp"
                android:text="Select This Folder"
                android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
